# Rootful podman Quadlet: /etc/containers/systemd/tiny-engineer-broker.container
# Installed by scripts/deploy-broker.sh. TE_ROBOT_URL and TE_ROBOT_TOKEN live
# in /etc/tiny-engineer-broker.env (mode 600).
[Unit]
Description=Tiny Engineer Broker - one writer for the robot face
After=network-online.target

[Container]
ContainerName=tiny-engineer-broker
Image=localhost/tiny-engineer-broker:latest
PublishPort=8790:8790
Environment=TE_STATE_TTL_S=300
Environment=TE_ATTENTION_REPEAT_S=30
Environment=TE_ATTENTION_MAX_S=900
EnvironmentFile=/etc/tiny-engineer-broker.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
